# Gemini API Configuration
GEMINI_API_KEY=your-api-key-here

# Logging Configuration (all optional with defaults)
# GEMINI_LOG_ENABLED=true              # Set to false to disable all logging
# GEMINI_LOG_LEVEL=info                # Options: debug, info, warn, error
# GEMINI_LOG_FIFO=/tmp/gemini-repl.fifo # FIFO path for real-time monitoring
# GEMINI_LOG_FILE=logs/gemini-repl.log  # File path for persistent logs

# Node.js Configuration
# NODE_ENV=development                  # Options: development, production
# NODE_OPTIONS=--max-old-space-size=4096 # Node.js runtime options
# NODE_PATH=.                           # Additional module search path