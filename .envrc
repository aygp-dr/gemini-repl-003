#!/usr/bin/env bash
# Robust .envrc for direnv

# Load .env file if it exists
if [ -f .env ]; then
    # Export all variables from .env
    set -a
    source .env
    set +a
    
    # Verify critical environment variables
    if [ -z "$GEMINI_API_KEY" ]; then
        echo "Warning: GEMINI_API_KEY not set in .env" >&2
    fi
else
    echo "Warning: .env file not found" >&2
    echo "Copy .env.example to .env and add your API key" >&2
fi

# Set up project-specific paths
export NODE_PATH="./node_modules:$NODE_PATH"
export PATH="./node_modules/.bin:$PATH"

# Set Claude project directory if not already set
if [ -z "$CLAUDE_PROJECT_DIR" ]; then
    export CLAUDE_PROJECT_DIR="$HOME/.claude/projects/$(pwd | tr '/' '-')"
fi

# Optional: Set Node.js memory limit for Shadow-CLJS builds
export NODE_OPTIONS="--max-old-space-size=4096"

# Success message
echo "Environment loaded for Gemini REPL project"